generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator effect {
  provider         = "effect-prisma-generator"
  output           = "../src/generated/effect-prisma.ts"
  clientImportPath = "./prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Statut {
  id          String    @id
  description String
  isDefault   Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   Int?

  employees              Employee[]
  statutStagePermissions StatutStagePermission[]

  @@map("statuts")
}

model StatutStagePermission {
  statutId String
  stage    ProjectStage

  statut Statut @relation(fields: [statutId], references: [id], onDelete: Cascade)

  @@id([statutId, stage])
  @@index([stage])
  @@map("statutStagePermissions")
}

model Employee {
  id           Int       @id @default(autoincrement())
  name         String
  weeklyTarget Float     @default(40)
  statutId     String?   @default("atelier")
  displayOrder Int       @default(999)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedBy    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  statut            Statut?             @relation(fields: [statutId], references: [id], onDelete: SetDefault)
  timeEntries       TimeEntry[]
  frozenWeeks       FrozenWeek[]
  weeklyKilometrage WeeklyKilometrage[]
  weeklyObjectives  WeeklyObjective[]
  user              User?

  @@map("employees")
}

model User {
  id                 String    @id
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  role               String?
  banned             Boolean?  @default(false)
  banReason          String?
  banExpires         DateTime?
  employeeId         Int?      @unique
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee     Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions     Session[]
  accounts     Account[]
  noteVersions ProjectNoteVersion[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model TimeEntryProject {
  id          Int         @id @default(autoincrement())
  timeEntryId Int
  projectId   String?
  taskId      Int?
  projectType ProjectType

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([timeEntryId, projectId, taskId])
  @@index([projectId])
  @@index([taskId])
  @@map("timeEntryProjects")
}

enum ProjectType {
  trello
  task
}

enum Role {
  employee
  manager
}

enum ProjectStage {
  venteDesign
  planification
  programmation
  production
  finition
  livraison
  installation
  termine
}

model TimeEntry {
  id          Int       @id @default(autoincrement())
  employeeId  Int?
  start       DateTime
  end         DateTime?
  entryMethod String    @default("manual") // 'manual', 'punch', etc.
  subtaskId   String    @default("1default")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  subtask  Subtask            @relation(fields: [subtaskId], references: [id], onDelete: SetDefault)
  projects TimeEntryProject[]

  @@index([employeeId])
  @@index([start])
  @@map("timeEntries")
}

model Subtask {
  id          String    @id
  description String
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timeEntries TimeEntry[]

  @@map("subtasks")
}

model FrozenWeek {
  employeeId Int
  weekStart  DateTime  @db.Date
  weekTotal  Float
  objective  Float
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, weekStart])
  @@map("frozenWeeks")
}

model WeeklyKilometrage {
  employeeId  Int
  weekStart   DateTime  @db.Date
  kilometrage Float     @default(0)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, weekStart])
  @@map("weeklyKilometrage")
}

model WeeklyObjective {
  employeeId Int
  weekStart  DateTime  @db.Date
  objective  Float
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, weekStart])
  @@map("weeklyObjectives")
}

model Project {
  id    String        @id
  name  String
  stage ProjectStage?

  useSignatureDate    Boolean   @default(false)
  signatureDate       DateTime? @db.Date
  manualSignatureDate DateTime? @db.Date

  useApprovalDate    Boolean   @default(false)
  approvalDate       DateTime? @db.Date
  manualApprovalDate DateTime? @db.Date

  useDeliveryDate    Boolean   @default(false)
  deliveryDate       DateTime? @db.Date
  isDeliveryLocked   Boolean   @default(false)
  manualDeliveryDate DateTime? @db.Date

  useDaysSignatureToApproval Boolean @default(false)
  daysSignatureToApproval    Int?

  useDaysApprovalToDelivery Boolean @default(false)
  daysApprovalToDelivery    Int?

  submissionPrice Float

  useExtraProductionDelay Boolean @default(false)
  extraProductionDays     Int?

  useExtraPlanningDelay Boolean @default(false)
  extraPlanningDays     Int?

  priority      Int     @default(0)
  color         String  @default("#4CAF50")
  isInCalendar  Boolean @default(false)
  calendarOrder Int     @default(0)
  isLocked      Boolean @default(false)

  address String @default("")

  productionDurationDays Int?
  planningDurationDays   Int?

  calculatedPlanningStart   DateTime? @db.Date
  calculatedPlanningEnd     DateTime? @db.Date
  calculatedProductionStart DateTime? @db.Date
  calculatedProductionEnd   DateTime? @db.Date
  calculatedDeliveryDate    DateTime? @db.Date

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  timeEntryProjects TimeEntryProject[]
  contacts          ProjectContact[]
  phases            ProjectPhase[]
  pieces            ProjectPiece[]
  notes             ProjectNote[]
  calendarEvents    CalendarEvent[]

  @@index([stage])
  @@map("projects")
}

model ProjectContact {
  id        Int      @id @default(autoincrement())
  projectId String
  role      String   @default("")
  name      String   @default("")
  company   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("projectContacts")
}

model ProjectPhase {
  id        Int      @id @default(autoincrement())
  projectId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pieces  ProjectPiece[]
  notes   ProjectNote[]

  @@index([projectId])
  @@map("projectPhases")
}

model ProjectPiece {
  id              Int      @id @default(autoincrement())
  projectId       String
  phaseId         Int?
  type            String   @default("")
  caissonMaterial String   @default("")
  cladding        String   @default("")
  doors           String   @default("")
  drawers         String   @default("")
  hardware        String   @default("")
  finish          String   @default("")
  cabinetCount    Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([phaseId])
  @@map("projectPieces")
}

model ProjectNote {
  id        Int       @id @default(autoincrement())
  projectId String
  phaseId   Int?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    ProjectPhase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  versions ProjectNoteVersion[]

  @@index([projectId])
  @@index([phaseId])
  @@map("projectNotes")
}

model ProjectNoteVersion {
  id        Int           @id @default(autoincrement())
  noteId    Int
  authorId  String?
  body      String
  stage     ProjectStage?
  createdAt DateTime      @default(now())

  note   ProjectNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([noteId])
  @@map("projectNoteVersions")
}

enum CalendarEventType {
  livraison
  installation
  manuel
}

enum CalendarEventColor {
  blue
  teal
  purple
  orange
  pink
  indigo
  lime
  amber
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
  yearly
}

enum RecurrenceEnd {
  never
  date
  count
}

model CalendarEvent {
  id     Int                @id @default(autoincrement())
  type   CalendarEventType
  title  String
  detail String             @default("")
  date   DateTime           @db.Date
  hour   Int
  color  CalendarEventColor

  frequency RecurrenceFrequency?
  interval  Int                  @default(1)
  weekdays  Int[]
  endType   RecurrenceEnd        @default(never)
  endDate   DateTime?            @db.Date
  endCount  Int?

  trelloCardId String? @unique
  projectId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([projectId])
  @@map("calendarEvents")
}

model ChronoGroup {
  id             String   @id
  name           String
  color          String   @default("#666666")
  isDone         Boolean  @default(true)
  projectedHours Float?
  createdAt      DateTime @default(now())

  members    ChronoGroupMember[]
  financials ChronoGroupFinancial?

  @@map("chronoGroups")
}

model ChronoGroupMember {
  groupId     String
  projectType String
  projectId   String

  group ChronoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, projectType, projectId])
  @@map("chronoGroupMembers")
}

model ChronoProjectSettings {
  projectType    String
  projectId      String
  isHidden       Boolean  @default(false)
  color          String?
  isDone         Boolean  @default(true)
  projectedHours Float?
  createdAt      DateTime @default(now())

  @@id([projectType, projectId])
  @@map("chronoProjectSettings")
}

model ChronoARRow {
  id         Int      @id @default(autoincrement())
  factureNum String?
  dateStr    String?
  client     String
  montant    Float
  year       Int?
  createdAt  DateTime @default(now())

  projectValues     ChronoProjectValue[]
  projectValueLines ChronoProjectValueLine[]

  @@map("chronoARRows")
}

model ChronoProjectValue {
  entityType String
  entityId   String
  arRowId    Int?
  montant    Float
  createdAt  DateTime @default(now())

  arRow ChronoARRow? @relation(fields: [arRowId], references: [id], onDelete: SetNull)

  @@id([entityType, entityId])
  @@map("chronoProjectValues")
}

model ChronoLocalEntry {
  projectType        String
  projectId          String
  projectName        String
  date               DateTime @db.Date
  subtaskId          String   @default("1default")
  hours              Float
  subtaskName        String?
  employeeId         Int?
  employeeName       String?
  employeeStatutId   String?
  employeeStatutName String?
  trelloSourceId     String?
  trelloSourceName   String?
  createdAt          DateTime @default(now())

  @@id([projectType, projectId, date, subtaskId])
  @@map("chronoLocalEntries")
}

model ChronoFilterRule {
  id        String   @id
  name      String
  color     String   @default("#4a9eff")
  style     String   @default("solid")
  isHidden  Boolean  @default(false)
  hasValue  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  sources ChronoFilterSource[]

  @@map("chronoFilterRules")
}

model ChronoFilterSource {
  id          Int      @id @default(autoincrement())
  ruleId      String
  tableType   String
  matchValue  String
  stepOrder   Int      @default(0)
  matchValues String?
  createdAt   DateTime @default(now())

  rule ChronoFilterRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("chronoFilterSources")
}

model ChronoProjectValueLine {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   String
  arRowId    Int?
  montant    Float
  createdAt  DateTime @default(now())

  arRow ChronoARRow? @relation(fields: [arRowId], references: [id], onDelete: SetNull)

  @@map("chronoProjectValueLines")
}

model ChronoGroupFinancial {
  groupId         String   @id
  hardwareCost    Float    @default(0)
  materialCost    Float    @default(0)
  installationPct Float    @default(0)
  paintshopCost   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group ChronoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("chronoGroupFinancials")
}

model CapacityCurve {
  id                 Int    @id @default(autoincrement())
  dayPosition        String
  maxCapacityPercent Int
  sortOrder          Int

  @@map("capacityCurve")
}

model ShopClosure {
  id          Int      @id @default(autoincrement())
  closureDate DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now())

  @@map("shopClosures")
}

model Task {
  id        Int       @id @default(autoincrement())
  name      String
  color     String    @default("#3498db")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  timeEntryProjects TimeEntryProject[]

  @@map("tasks")
}

model Setting {
  key         String  @id
  value       String
  type        String
  description String?

  @@map("settings")
}
