{
  "name": "versatyl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test": "vitest",
    "test:ci": "npm run db:validate && npm run type-check && vitest run",
    "dev": "next dev",
    "db:dev": "docker-compose -f docker-compose.yml up",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:deleteMigrations": "rimraf prisma/migrations",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed && npm run db:createUsers && npm run db:import-trello-events",
    "db:createUsers": "tsx --conditions=react-server prisma/createUsers.ts",
    "db:import-trello-events": "tsx --conditions=react-server prisma/importTrelloEvents.ts",
    "db:studio": "prisma studio",
    "db:re-port-from-scratch": "npm run db:validate && npm run db:format && npm run db:generate && npm run db:deleteMigrations && npm run db:reset -- --force && npm run db:migrate -- --name initial",
    "build": "npm run db:deploy && next build",
    "start": "next start",
    "with-staging-db": "cross-env NODE_OPTIONS=\"-r dotenv/config\" DOTENV_CONFIG_PATH=.env.staging",
    "db:reset:staging": "npm run with-staging-db -- npm run db:reset",
    "db:status:staging": "npm run with-staging-db -- npm run db:status",
    "db:deploy:staging": "npm run with-staging-db -- npm run db:deploy",
    "db:seed:staging": "npm run with-staging-db -- npm run db:seed",
    "db:createUsers:staging": "npm run with-staging-db -- npm run db:createUsers",
    "with-prod-db": "cross-env NODE_OPTIONS=\"-r dotenv/config\" DOTENV_CONFIG_PATH=.env.prod",
    "db:status:prod": "npm run with-prod-db -- npm run db:status",
    "db:deploy:prod": "npm run with-prod-db -- npm run db:deploy",
    "db:seed:prod": "npm run with-prod-db -- npm run db:seed",
    "db:createUsers:prod": "npm run with-prod-db -- npm run db:createUsers",
    "analyze": "next experimental-analyze",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "dotenv": "17.4.2",
    "effect": "3.22.1",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/ui": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "effect-prisma-generator": "0.10.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.13"
  }
}
