{
  "name": "versatyl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "db": "docker-compose -f docker-compose.yml up",
    "dev": "next dev",
    "test": "npm run db:validate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:deleteMigrations": "rm -rf prisma/migrations",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:re-port-from-scratch": "npm run db:validate && npm run db:format && npm run db:generate && npm run db:deleteMigrations && npm run db:reset -- --force && npm run db:migrate -- --name initial",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "iron-session": "8.0.4",
    "jose": "6.2.3",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "pg": "8.22.0",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "1.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "babel-plugin-react-compiler": "1.0.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.13"
  }
}
