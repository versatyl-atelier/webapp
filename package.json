{
  "name": "versatyl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "test": "vitest",
    "test:ci": "npm run db:validate && npm run type-check && vitest run",
    "dev": "next dev",
    "db:dev": "docker-compose -f docker-compose.yml up",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:deleteMigrations": "rimraf prisma/migrations",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:re-port-from-scratch": "npm run db:validate && npm run db:format && npm run db:generate && npm run db:deleteMigrations && npm run db:reset -- --force && npm run db:migrate -- --name initial",
    "build": "next build",
    "start": "next start",
    "with-remote-db": "cross-env NODE_OPTIONS=\"-r dotenv/config\" DOTENV_CONFIG_PATH=.env.remote",
    "db:reset:remote": "npm run with-remote-db -- npm run db:reset",
    "db:deploy:remote": "npm run with-remote-db -- npm run db:deploy",
    "analyze": "next experimental-analyze",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "effect": "3.22.1",
    "iron-session": "8.0.4",
    "jose": "6.2.10",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "1.0.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/ui": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "effect-prisma-generator": "0.10.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.13"
  }
}
