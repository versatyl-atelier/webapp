{
  "name": "versatyl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "prepare": "effect-language-service patch",
    "test": "vitest",
    "test:ci": "npm run db:validate && npm run type-check",
    "dev": "next dev",
    "db:dev": "docker-compose -f docker-compose.yml up",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:deleteMigrations": "rm -rf prisma/migrations",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:re-port-from-scratch": "npm run db:validate && npm run db:format && npm run db:generate && npm run db:deleteMigrations && npm run db:reset -- --force && npm run db:migrate -- --name initial",
    "build": "next build",
    "start": "next start",
    "with-remote-db": "cross-env NODE_OPTIONS=\"-r dotenv/config\" DOTENV_CONFIG_PATH=.env.remote",
    "analyze": "next experimental-analyze",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "effect": "3.21.4",
    "iron-session": "8.0.4",
    "jose": "6.2.3",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "pg": "8.22.0",
    "radix-ui": "1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "shadcn": "4.13.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "1.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.4",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.0",
    "@types/pg": "8.20.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/ui": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.13"
  }
}
